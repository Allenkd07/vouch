# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://jobmatcher:jobmatcher@localhost:5433/jobmatcher

# gemini | fake (fake = canned responses, for tests / offline work)
LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check current model names at https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
# Reading job requirements (runs for every discovered job; separate quota from LLM_MODEL)
EXTRACTION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
