# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://jobmatcher:jobmatcher@localhost:5433/jobmatcher

# gemini | fake (fake = canned responses, for tests / offline work)
LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check current model names at https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
# Reading job requirements (runs for every discovered job; separate quota from LLM_MODEL)
EXTRACTION_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2

# Independent judge for `vouch eval tailoring` (evals only): a different, stronger model than
# LLM_MODEL. Vertex AI bills a Google Cloud project; sign in once with
#   gcloud auth application-default login
# JUDGE_PROVIDER defaults to LLM_PROVIDER. Evals need far more than the free tier's ~20
# requests/day; run one on Vertex too with, in PowerShell:
#   $env:LLM_PROVIDER = 'vertex'; uv run vouch eval tailoring
JUDGE_PROVIDER=vertex
JUDGE_MODEL=gemini-3.1-pro-preview
GCP_PROJECT=
GCP_LOCATION=global
